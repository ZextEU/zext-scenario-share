+local function inflate(src, start, maxOut)
+    local pos, buf, cnt = start, 0, 0
+    local out, n = {}, 0
+    local function bits(k)
+        while cnt < k do
+            local b = src:byte(pos)
+            if not b then error('cut short', 0) end
+            pos = pos + 1
+            buf = buf | (b << cnt)
+            cnt = cnt + 8
+        end
+        local v = buf & ((1 << k) - 1)
+        buf, cnt = buf >> k, cnt - k
+        return v
